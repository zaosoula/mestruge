  "ladyofvictoriesHeroTitle": "{navLadyOfVictories}",
  "ladyofvictoriesHeroBackground": "%baseurl%/assets/images/photos/ladyofvictories/2.jpg",

  "ladyofvictoriesSectionWelcomeImageUrl": "%baseurl%/assets/images/photos/ladyofvictories/1.jpg",
  "ladyofvictoriesSectionWelcomeImageAlt": "{ladyofvictoriesHeroTitle}",
  "ladyofvictoriesSectionWelcomeTitle": "{ladyofvictoriesHeroTitle}",
  "ladyofvictoriesSectionWelcomeText": "Notre Dame des Victoires  est une petite statue que nous avons trouvée sur le bord d’une fenêtre nichée sous le toit, protégeant Mestrugue.<br>Selon l’Histoire, en 1614, le roi Louis XVIII prononça le vœu dans une église d’Aubervilliers de construire une église à Paris dédiée à notre Sainte Mère s’il remportait une victoire militaire contre les protestants. Il fut exaucé en 1628 au siège de la Rochelle et décida de construire l’église de notre Dame des Victoires.<br>Nous avons demandé à une amie d’écrire une icône de notre Dame des Victoires et avons replacé la statue à sa place. Ainsi elle continue de protéger Mestrugue.",
  "ladyofvictoriesSectionWelcomeButtonPrimary": "En savoir plus",


