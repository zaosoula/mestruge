  "directionItineraryNotice": "<i class='far fa-lightbulb pr-2'></i> Use this link to get the correct itinerary: <a href='https://goo.gl/maps/F8zJCmf7geHwjtiz6' target='_blank'>https://goo.gl/maps/F8zJCmf7geHwjtiz6</a>",
  "directionItineraryTitle": "ARRIVAL IN MONTREAL:",
  "directionItinerarySteps": "<li>Turn left at Pizzeria Bar L’Express</li><li>At the roundabout take the first exit and follow the road down.</li><li>Turn left at the Cailhau D8 sign</li><li>Follow the road to the sign telling you that you are leaving Montreal</li><li>Cross the bridge and continue straight (from here Mestrugue is about 6 km)</li><li>At the first stone cross, turn left. (there is a post listing all the properties) In no case follow Cailhau D8!</li><li>Drive about 4 km, Mestrugue is the last property</li><li>At the crossroads after the vines, you will see a brown container and the Mestrugue sign, turn right and you will reach your destination</li><li>Welcome to Mestrugue</li>",
  "directionCoordsLabel": "Coords:",
  "directionCoords": "Latitude 43.160767 <br> Longitude 2.15339",
  "directionByCarLabel": "By car",
  "directionByCarFrom1Label": "From Narbonne:",
  "directionByCarFrom1": "In Narbonne you take the direction Toulouse A61. Take the Bram exit (exit 22). Once in Bram, just follow the signs to Montreal.",
  "directionByCarFrom2Label": "From Toulouse:",
  "directionByCarFrom2": "From Toulouse, take the A61 towards Carcassonne. Take the Bram exit (exit 22). Once in Bram, just follow the signs to Montreal.",
  "directionByPlaneLabel": "By plane",
  "directionByPlane": "Either by Carcassonne airport 15 km from Montreal (Rayanair), or by Toulouse airport at 85 km (all airlines).",
  "directionByPlaneFrom1Label": "From CARCASSONNE airport:",
  "directionByPlaneFrom1": "Take the D119 road to Montreal",


  "ladyofvictoriesHeroTitle": "{navLadyOfVictories}",
  "ladyofvictoriesHeroBackground": "%baseurl%/assets/images/photos/ladyofvictories/2.jpg",

  "ladyofvictoriesSectionWelcomeImageUrl": "%baseurl%/assets/images/photos/ladyofvictories/1.jpg",
  "ladyofvictoriesSectionWelcomeImageAlt": "{ladyofvictoriesHeroTitle}",
  "ladyofvictoriesSectionWelcomeTitle": "{ladyofvictoriesHeroTitle}",
  "ladyofvictoriesSectionWelcomeText": "Our Mother of Victories is a little statue we found at the edge of a window nestled under the roof protecting Mestrugue.<br>Regarding the History, in year 1614, the King Louis XIII pronounced the wish in a church of Aubervilliers to build a church in Paris dedicated to our Holy Mother if he wins a military victory against Protestants. Granted in 1628 following the siege of La Rochelle, he decided to build the church for our Lady of Victories.<br>We asked a friend to write an icon of our Lady of Victories. We set the statue back at his place from where it continues to protect Mestrugue.",
